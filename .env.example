TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=
ADMIN_TELEGRAM_ID=
ADMIN_TELEGRAM_IDS=
CHANNEL_ID=
CONTACT_USERNAME=
TIMEZONE=Asia/Ashgabat

GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_SIZE=1K

OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_COST_USD=0
GEMINI_IMAGE_COST_USD=0

MOCKUP_VARIANTS=1
DATABASE_URL=
ALLOW_SQLITE_FALLBACK=false
DATABASE_PATH=data/posts.sqlite3
CAPTION_TEMPLATE_PATH=data/caption_template.txt
BUTTON_TEXT=Написать
COPY_LANGUAGE=ru

# Pinterest automatic reference search. A non-empty token enables search by default.
PINTEREST_ACCESS_TOKEN=
PINTEREST_SEARCH_ENABLED=true
PINTEREST_COUNTRY_CODE=US
PINTEREST_SEARCH_INTERVAL_SECONDS=21600
PINTEREST_TARGET_POOL_SIZE=160
PINTEREST_QUERIES_PER_CYCLE=2
